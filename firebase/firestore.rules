rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      // Only the owner can read their profile.
      allow read: if request.auth != null && request.auth.uid == uid;

      // Owner can create their own profile, but never as premium.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.isPremium == false
        && validProfile(request.resource.data);

      // Owner can update names/phone fields, but cannot change
      // uid, email, or isPremium from the client. Premium is set
      // server-side (Cloud Function / Admin SDK) after a verified purchase.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.isPremium == resource.data.isPremium
        && validProfile(request.resource.data);

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Premium cloud library sync — owner-only. One JSON snapshot doc lives at
    // users/{uid}/library/snapshot.
    match /users/{uid}/library/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Maps a StoreKit appAccountToken → uid so the App Store server-notification
    // webhook can find the buyer. Create-only and immutable, so a token can't be
    // re-pointed to hijack someone else's purchase. Only the Admin SDK (server)
    // reads it; clients can never read this collection.
    match /purchaseTokens/{token} {
      allow read: if false;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/purchaseTokens/$(token));
      allow update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }

    function validProfile(data) {
      return data.firstName is string && data.firstName.size() <= 50
        && data.lastName is string && data.lastName.size() <= 50
        && (!('phoneLast4' in data) || (data.phoneLast4 is string && data.phoneLast4.size() <= 4))
        && (!('hashedPhone' in data) || (data.hashedPhone is string && data.hashedPhone.size() == 64))
        && (!('consentVersion' in data) || (data.consentVersion is string && data.consentVersion.size() <= 20))
        && (!('consentAcceptedAt' in data) || data.consentAcceptedAt is timestamp);
    }
  }
}
