// Copy to Secrets.xcconfig (gitignored) and fill in your own values.
// Never commit Secrets.xcconfig.

// AdMob → Apps → App settings → App ID
ADMOB_APP_ID = ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
// AdMob → Ad units → Anchored banner
ADMOB_BANNER_UNIT_ID = ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
// REVERSED_CLIENT_ID from your GoogleService-Info.plist (Google Sign-In URL scheme)
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.XXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
